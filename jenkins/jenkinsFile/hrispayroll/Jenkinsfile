pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }    

    environment {
        DB_URL = credentials('hris-db-url')
        DB_USERNAME = credentials('hris-db-username')
        DB_PASSWORD = credentials('hris-db-password')
        JWT_SECRET_KEY = credentials('hris-jwt-secret')
        JWT_EXPIRATION = credentials('hris-jwt-expiration')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build HRISSR') {
            steps {
                dir('HRISSR') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build HRISGW') {
            steps {
                dir('HRISGW') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build HRISWS') {
            steps {
                dir('HRISWS') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('HRISWS') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Prepare Image Tag') {
            steps {
                script {
                    def timestamp = sh(
                        script: 'date +%Y%m%d%H%M%S',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "jenkins-${BUILD_NUMBER}-${timestamp}"

                    echo "============================================================"
                    echo " NEW IMAGE VERSION"
                    echo "============================================================"
                    echo "New image tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Save Previous Version') {
            steps {
                script {
                    def previousTag = sh(
                        script: '''
                            docker inspect hrisws \
                                --format='{{.Config.Image}}' 2>/dev/null \
                                | sed 's/^hris-hrisws://'
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!previousTag) {
                        error "Could not determine previous HRIS image tag."
                    }

                    env.PREVIOUS_IMAGE_TAG = previousTag

                    echo "============================================================"
                    echo " DEPLOYMENT VERSION TRACKING"
                    echo "============================================================"
                    echo "Previous image tag: ${env.PREVIOUS_IMAGE_TAG}"
                    echo "New image tag     : ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh """
                    docker build -t hris-hrissr:${IMAGE_TAG} HRISSR
                    docker build -t hris-hrisgw:${IMAGE_TAG} HRISGW
                    docker build -t hris-hrisws:${IMAGE_TAG} HRISWS
                    docker build -t hris-hrisportal:${IMAGE_TAG} HRISPortal
                """
            }
        }

        stage('Deploy HRIS') {
            steps {
                script {

                    env.DEPLOYMENT_STARTED = 'false'

                    try {

                        withCredentials([
                            string(credentialsId: 'hris-db-url', variable: 'DB_URL'),
                            string(credentialsId: 'hris-db-username', variable: 'DB_USERNAME'),
                            string(credentialsId: 'hris-db-password', variable: 'DB_PASSWORD'),
                            string(credentialsId: 'hris-jwt-secret', variable: 'JWT_SECRET_KEY'),
                            string(credentialsId: 'hris-jwt-expiration', variable: 'JWT_EXPIRATION')
                        ]) {
                            sh '''
                                export IMAGE_TAG="${IMAGE_TAG}"

                                export HRISSR_HOST=hrissr
                                export HRISSR_PORT=8761

                                export DB_URL="${DB_URL}"
                                export DB_USERNAME="${DB_USERNAME}"
                                export DB_PASSWORD="${DB_PASSWORD}"

                                export JWT_SECRET_KEY="${JWT_SECRET_KEY}"
                                export JWT_EXPIRATION="${JWT_EXPIRATION}"

                                echo "============================================================"
                                echo " DEPLOYING HRIS"
                                echo "============================================================"
                                echo ""
                                echo "Previous version: ${PREVIOUS_IMAGE_TAG}"
                                echo "New version     : ${IMAGE_TAG}"
                                echo ""

                                docker compose -p payroll down

                                echo ""
                                echo "Starting HRIS with image tag ${IMAGE_TAG}..."

                                docker compose -p payroll up -d
                            '''
                        }

                        env.DEPLOYMENT_STARTED = 'true'

                        /*
                         * ========================================================
                         * HEALTH CHECK
                         * ========================================================
                         *
                         * Docker performs the actual healthchecks.
                         * Jenkins polls Docker's health status every 10 seconds.
                         *
                         * 18 attempts x 10 seconds = approximately 3 minutes.
                         */
                        sh '''
                            echo "============================================================"
                            echo " HRIS HEALTH CHECKS"
                            echo "============================================================"
                            echo ""

                            MAX_ATTEMPTS=18
                            SLEEP_SECONDS=10

                            for i in $(seq 1 $MAX_ATTEMPTS); do

                                HRISSR_STATUS=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    hrissr 2>/dev/null || echo "missing")

                                HRISWS_STATUS=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    hrisws 2>/dev/null || echo "missing")

                                HRISGW_STATUS=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    hrisgw 2>/dev/null || echo "missing")

                                HRISPORTAL_STATUS=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    hrisportal 2>/dev/null || echo "missing")

                                echo ""
                                echo "Health check attempt $i/$MAX_ATTEMPTS"
                                echo "  HRISSR     : $HRISSR_STATUS"
                                echo "  HRISWS     : $HRISWS_STATUS"
                                echo "  HRISGW     : $HRISGW_STATUS"
                                echo "  HRISPortal : $HRISPORTAL_STATUS"

                                if [ "$HRISSR_STATUS" = "healthy" ] && \
                                   [ "$HRISWS_STATUS" = "healthy" ] && \
                                   [ "$HRISGW_STATUS" = "healthy" ] && \
                                   [ "$HRISPORTAL_STATUS" = "healthy" ]; then

                                    echo ""
                                    echo "============================================================"
                                    echo " ALL HRIS CONTAINERS ARE HEALTHY"
                                    echo "============================================================"

                                    docker compose -p payroll ps

                                    exit 0
                                fi

                                if [ "$i" -lt "$MAX_ATTEMPTS" ]; then
                                    echo ""
                                    echo "Waiting ${SLEEP_SECONDS}s for Docker healthchecks..."
                                    sleep "$SLEEP_SECONDS"
                                fi
                            done

                            echo ""
                            echo "============================================================"
                            echo " HRIS HEALTH CHECK FAILED"
                            echo "============================================================"

                            docker compose -p payroll ps

                            echo ""
                            echo "============================================================"
                            echo " UNHEALTHY CONTAINER DETAILS"
                            echo "============================================================"

                            for container in hrissr hrisws hrisgw hrisportal; do

                                STATUS=$(docker inspect \
                                    --format='{{.State.Health.Status}}' \
                                    "$container" 2>/dev/null || echo "missing")

                                if [ "$STATUS" != "healthy" ]; then

                                    echo ""
                                    echo "------------------------------------------------------------"
                                    echo "$container : $STATUS"
                                    echo "------------------------------------------------------------"

                                    echo ""
                                    echo "Health state:"
                                    docker inspect "$container" \
                                        --format='{{json .State.Health}}' \
                                        2>/dev/null || true

                                    echo ""
                                    echo "Recent logs:"
                                    docker logs --tail 50 "$container" \
                                        2>&1 || true
                                fi
                            done

                            exit 1
                        '''

                    } catch (Exception e) {

                        echo "============================================================"
                        echo " DEPLOYMENT FAILED"
                        echo "============================================================"
                        echo ""
                        echo "New version failed health verification."
                        echo ""
                        echo "Previous version:"
                        echo "${env.PREVIOUS_IMAGE_TAG}"
                        echo ""

                        if (env.DEPLOYMENT_STARTED == 'true') {

                            echo "============================================================"
                            echo " AUTOMATIC ROLLBACK"
                            echo "============================================================"

                            withCredentials([
                                string(credentialsId: 'hris-db-url', variable: 'DB_URL'),
                                string(credentialsId: 'hris-db-username', variable: 'DB_USERNAME'),
                                string(credentialsId: 'hris-db-password', variable: 'DB_PASSWORD'),
                                string(credentialsId: 'hris-jwt-secret', variable: 'JWT_SECRET_KEY'),
                                string(credentialsId: 'hris-jwt-expiration', variable: 'JWT_EXPIRATION')
                            ]) {
                                sh '''
                                    export IMAGE_TAG="${PREVIOUS_IMAGE_TAG}"

                                    export HRISSR_HOST=hrissr
                                    export HRISSR_PORT=8761

                                    export DB_URL="${DB_URL}"
                                    export DB_USERNAME="${DB_USERNAME}"
                                    export DB_PASSWORD="${DB_PASSWORD}"

                                    export JWT_SECRET_KEY="${JWT_SECRET_KEY}"
                                    export JWT_EXPIRATION="${JWT_EXPIRATION}"

                                    echo "Restoring previous version..."
                                    echo "IMAGE_TAG=${IMAGE_TAG}"
                                    echo ""

                                    docker compose -p payroll down
                                    docker compose -p payroll up -d
                                '''
                            }

                            echo ""
                            echo "Rollback deployment started."

                            /*
                             * ====================================================
                             * ROLLBACK HEALTH CHECK
                             * ====================================================
                             */

                            sh '''
                                echo "============================================================"
                                echo " ROLLBACK HEALTH CHECKS"
                                echo "============================================================"

                                MAX_ATTEMPTS=18
                                SLEEP_SECONDS=10

                                for i in $(seq 1 $MAX_ATTEMPTS); do

                                    HRISSR_STATUS=$(docker inspect \
                                        --format='{{.State.Health.Status}}' \
                                        hrissr 2>/dev/null || echo "missing")

                                    HRISWS_STATUS=$(docker inspect \
                                        --format='{{.State.Health.Status}}' \
                                        hrisws 2>/dev/null || echo "missing")

                                    HRISGW_STATUS=$(docker inspect \
                                        --format='{{.State.Health.Status}}' \
                                        hrisgw 2>/dev/null || echo "missing")

                                    HRISPORTAL_STATUS=$(docker inspect \
                                        --format='{{.State.Health.Status}}' \
                                        hrisportal 2>/dev/null || echo "missing")

                                    echo ""
                                    echo "Rollback health check $i/$MAX_ATTEMPTS"
                                    echo "  HRISSR     : $HRISSR_STATUS"
                                    echo "  HRISWS     : $HRISWS_STATUS"
                                    echo "  HRISGW     : $HRISGW_STATUS"
                                    echo "  HRISPortal : $HRISPORTAL_STATUS"

                                    if [ "$HRISSR_STATUS" = "healthy" ] && \
                                       [ "$HRISWS_STATUS" = "healthy" ] && \
                                       [ "$HRISGW_STATUS" = "healthy" ] && \
                                       [ "$HRISPORTAL_STATUS" = "healthy" ]; then

                                        echo ""
                                        echo "============================================================"
                                        echo " ROLLBACK COMPLETED SUCCESSFULLY"
                                        echo "============================================================"

                                        docker compose -p payroll ps

                                        exit 0
                                    fi

                                    if [ "$i" -lt "$MAX_ATTEMPTS" ]; then
                                        echo ""
                                        echo "Waiting ${SLEEP_SECONDS}s for rollback healthchecks..."
                                        sleep "$SLEEP_SECONDS"
                                    fi
                                done

                                echo ""
                                echo "============================================================"
                                echo " ROLLBACK HEALTH CHECK FAILED"
                                echo "============================================================"

                                docker compose -p payroll ps

                                echo ""
                                echo "Rollback could not be verified."
                                echo "FAILED DEPLOYMENT IMAGES WILL BE RETAINED."

                                exit 1
                            '''

                            /*
                             * ====================================================
                             * REMOVE FAILED DEPLOYMENT IMAGES
                             * ====================================================
                             *
                             * This is intentionally AFTER rollback health checks.
                             *
                             * If rollback succeeds:
                             *     delete Build N images
                             *
                             * If rollback fails:
                             *     Build N images remain for troubleshooting.
                             */

                            echo ""
                            echo "============================================================"
                            echo " REMOVING FAILED DEPLOYMENT IMAGES"
                            echo "============================================================"

                            sh '''
                                echo "Failed deployment tag: ${IMAGE_TAG}"
                                echo ""

                                docker image rm \
                                    "hris-hrissr:${IMAGE_TAG}" \
                                    "hris-hrisgw:${IMAGE_TAG}" \
                                    "hris-hrisws:${IMAGE_TAG}" \
                                    "hris-hrisportal:${IMAGE_TAG}" \
                                    || true

                                echo ""
                                echo "Failed deployment image cleanup completed."
                            '''

                        }

                        /*
                         * Keep Jenkins build result as FAILURE.
                         *
                         * The application was rolled back successfully,
                         * but the new deployment itself failed.
                         */
                        throw e
                    }
                }
            }
        }

        stage('Verify Final Version') {
            steps {
                sh '''
                    echo "============================================================"
                    echo " FINAL HRIS VERSION"
                    echo "============================================================"

                    docker inspect hrisws \
                        --format "{{.Config.Image}}"

                    docker inspect hrisgw \
                        --format "{{.Config.Image}}"

                    docker inspect hrissr \
                        --format "{{.Config.Image}}"

                    docker inspect hrisportal \
                        --format "{{.Config.Image}}"

                    echo ""
                    docker compose -p payroll ps
                '''
            }
        }

        /*
         * ============================================================
         * DOCKER IMAGE RETENTION
         * ============================================================
         *
         * Runs only after a successful deployment.
         *
         * Keeps:
         *   1. Current deployment
         *   2. Previous deployment / rollback target
         *
         * Removes older Jenkins HRIS images.
         */

        stage('Cleanup Old HRIS Images') {
            steps {
                sh '''
                    echo "============================================================"
                    echo " DOCKER IMAGE RETENTION"
                    echo "============================================================"

                    echo ""
                    echo "Current deployment : ${IMAGE_TAG}"
                    echo "Rollback target    : ${PREVIOUS_IMAGE_TAG}"

                    echo ""
                    echo "HRIS images before cleanup:"

                    docker images --format '{{.Repository}}:{{.Tag}}' |
                        grep '^hris-hris' |
                        grep ':jenkins-' |
                        sort || true

                    echo ""
                    echo "Keeping:"
                    echo "  Current  : ${IMAGE_TAG}"
                    echo "  Previous : ${PREVIOUS_IMAGE_TAG}"

                    for repository in \
                        hris-hrissr \
                        hris-hrisgw \
                        hris-hrisws \
                        hris-hrisportal
                    do

                        echo ""
                        echo "Processing ${repository}..."

                        docker images "$repository" \
                            --format '{{.Repository}}:{{.Tag}}' |
                        while read image; do

                            [ -z "$image" ] && continue

                            tag="${image#${repository}:}"

                            # Never delete the current deployment.
                            if [ "$tag" = "${IMAGE_TAG}" ]; then
                                echo "KEEP: $image"
                                continue
                            fi

                            # Never delete the rollback target.
                            if [ "$tag" = "${PREVIOUS_IMAGE_TAG}" ]; then
                                echo "KEEP: $image"
                                continue
                            fi

                            # Only remove Jenkins-generated HRIS images.
                            if echo "$tag" | grep -q '^jenkins-'; then
                                echo "REMOVE: $image"
                                docker image rm "$image" || true
                            fi

                        done

                    done

                    echo ""
                    echo "============================================================"
                    echo " IMAGE RETENTION COMPLETE"
                    echo "============================================================"

                    echo ""
                    echo "HRIS images after cleanup:"

                    docker images --format '{{.Repository}}:{{.Tag}}' |
                        grep '^hris-hris' |
                        grep ':jenkins-' |
                        sort || true
                '''
            }
        }
    }

    post {
        success {
            echo 'HRIS SonarQube + Docker + Deployment + Health Checks + Image Retention completed successfully.'
        }

        failure {
            echo 'HRIS pipeline failed. Automatic rollback was attempted if deployment had started.'
        }
    }
}